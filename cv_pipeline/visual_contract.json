    "body_line_height": 1.17,
    "heading_size_pt": 10.7,
    "section_headings": ["Professional Summary", "Skills", "Experience", "Projects", "Education"],
    "forbidden_headings": ["Selected Projects"],
    "bullet_text_indent_mm": 1.9,
    "bullet_marker_offset_mm": 0.2,
    "bullet_alignment_tolerance_pt": 0.75,
    "default_max_pages": 1
  },
  "cover_letter": {
    "page_margin_mm": [14.0, 17.0, 14.0, 17.0],
    "body_size_pt": 10.2,
    "body_line_height": 1.28,
    "role_size_pt": 11.5,
    "default_max_pages": 1
  }
}
