{
  "version": "jobhuntai-serif-v1",
  "shared": {
    "font_family_tokens": ["Times New Roman", "Liberation Serif"],
    "allowed_pdf_font_fragments": ["TimesNewRoman", "LiberationSerif", "NimbusRoman", "Tinos", "DejaVuSerif", "FreeSerif"],
    "name_size_pt": 17.0,
    "contact_size_pt": 8.35,
    "ink": "#111111",
    "link": "#0563c1",
    "rule": "#333333",
    "contact_links": ["LinkedIn", "Portfolio", "GitHub"],
    "portfolio_uri_contains": "varunrout.com",
    "geometry_tolerance_pt": 1.0,
    "font_tolerance_pt": 0.3
  },
  "cv": {
    "page_margin_mm": [12.0, 13.0, 11.0, 13.0],
