{
  "version": "jobhuntai-serif-blue-v3",
  "shared": {
    "font_family_tokens": ["Cormorant Garamond", "Lora", "Georgia", "serif"],
    "allowed_pdf_font_fragments": ["Cormorant", "Lora", "Georgia"],
    "name_size_pt": 23.0,
    "headline_size_pt": 11.5,
    "contact_size_pt": 8.8,
    "ink": "#201f1d",
    "link": "#1A4F8B",
    "button_ground": "#E9F0F8",
    "neutral_700": "#605d5d",
    "neutral_800": "#444141",
    "divider": "rgba(32,31,29,0.16)",
    "rule": "#201f1d",
    "portfolio_uri_contains": "varunrout.com",
    "github_uri_contains": "github.com/varunrout",
    "geometry_tolerance_pt": 1.5,
    "font_tolerance_pt": 0.55,
    "cta_dimension_tolerance_pt": 0.75,
    "cta_min_gap_pt": 3.5
  },
  "cv": {
    "page_margin_mm": [10.0, 10.0, 10.0, 10.0],
    "body_size_pt": 10.4,
    "body_line_height": 1.38,
    "heading_size_pt": 10.5,
    "heading_letter_spacing_em": 0.03,
    "section_headings": ["Professional Summary", "Skills", "Experience", "Projects", "Education"],
    "forbidden_headings": ["Selected Projects"],
    "bullet_text_indent_mm": 2.4,
    "bullet_marker_offset_mm": 0.25,
    "bullet_alignment_tolerance_pt": 0.9,
    "minimum_pages": 1,
    "maximum_pages": 2
  },
  "cover_letter": {
    "page_margin_mm": [10.0, 10.0, 10.0, 10.0],
    "body_size_pt": 10.4,
    "body_line_height": 1.38,
    "role_size_pt": 11.7,
    "required_pages": 1
  }
}
