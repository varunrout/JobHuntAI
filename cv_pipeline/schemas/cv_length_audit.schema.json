{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobhuntai.local/schemas/cv_length_audit.schema.json",
  "title": "JobHuntAI CV Length and Evidence Retention Audit",
  "type": "object",
  "required": [
    "contract",
    "strategy_decision",
    "strategy_rationale",
    "final_page_count",
    "candidate_role_profile",
    "essential_evidence",
    "omissions",
    "review_judgement",
    "page_transition",
    "page_fill"
  ],
  "properties": {
    "contract": {"const": "jobhuntai-cv-length-audit-v1"},
    "strategy_decision": {"enum": ["ONE_PAGE_ALLOWED", "TWO_PAGE_PREFERRED", "TWO_PAGE_REQUIRED"]},
    "strategy_rationale": {"type": "string", "minLength": 40},
    "final_page_count": {"enum": [1, 2]},
    "candidate_role_profile": {
      "type": "object",
      "required": ["seniority", "relevant_years", "relevant_roles", "relevant_projects", "technical_breadth", "domain_transfer_required"],
      "properties": {
        "seniority": {"type": "string", "minLength": 2},
        "relevant_years": {"type": "number", "minimum": 0},
        "relevant_roles": {"type": "integer", "minimum": 0},
        "relevant_projects": {"type": "integer", "minimum": 0},
        "technical_breadth": {"type": "integer", "minimum": 0},
        "domain_transfer_required": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "essential_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "match_any"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "match_any": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}
        },
        "additionalProperties": true
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "impact", "rationale"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "impact": {"enum": ["harmless", "strategic_loss"]},
          "rationale": {"type": "string", "minLength": 20}
        },
        "additionalProperties": true
      }
    },
    "review_judgement": {
      "type": "object",
      "required": ["material_evidence_removed", "omission_audit_complete", "page_strategy_approved", "rationale", "review_actor", "review_iteration", "cv_sha256"],
      "properties": {
        "material_evidence_removed": {"type": "boolean"},
        "omission_audit_complete": {"type": "boolean"},
        "page_strategy_approved": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 30},
        "review_actor": {"type": "string", "minLength": 1},
        "review_iteration": {"type": "integer", "minimum": 1},
        "cv_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "page_transition": {
      "type": "object",
      "properties": {
        "previous_page_count": {"enum": [1, 2]},
        "remediation_steps": {"type": "array", "items": {"type": "string"}},
        "fresh_strategic_review": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "page_fill": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "one_page_exception": {
      "type": "object",
      "properties": {
        "approved": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 30}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
