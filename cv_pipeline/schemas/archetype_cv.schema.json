{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobhuntai.local/schemas/archetype_cv.schema.json",
  "title": "JobHuntAI archetype CV payload",
  "type": "object",
  "required": [
    "layout_contract",
    "archetype",
    "role_identity",
    "identity",
    "summary",
    "skills",
    "experience",
    "projects",
    "education",
    "section_order",
    "section_labels",
    "page_strategy"
  ],
  "properties": {
    "layout_contract": {"const": "jobhuntai-archetype-v1"},
    "archetype": {"enum": ["data_scientist","analytics_engineer","data_engineer","strategy_innovation_analyst","commercial_analyst","football_performance_analyst","football_strategy_analyst","business_intelligence_analyst","forecasting_pricing_analyst","product_analytics","marketing_analytics"]},
    "role_identity": {"$ref": "#/$defs/role_identity"},
    "identity": {
      "type": "object",
      "required": ["name","headline","email","phone","location","linkedin","portfolio","github"],
      "properties": {
        "name": {"type": "string","minLength": 2},
        "headline": {"type": "string","minLength": 12},
        "email": {"type": "string"},
        "phone": {"type": "string"},
        "location": {"type": "string"},
        "linkedin": {"type": "string","pattern": "^https?://"},
        "portfolio": {"type": "string","pattern": "^https?://"},
        "github": {"type": "string","pattern": "^https?://"}
      },
      "additionalProperties": true
    },
    "summary": {"type": "string","minLength": 80},
    "skills": {
      "type": "array","minItems": 3,"maxItems": 6,
      "items": {"type": "object","required": ["category","items"],"properties": {"category": {"type": "string"},"items": {"type": "string"}},"additionalProperties": true}
    },
    "selected_impact": {
      "type": "array","maxItems": 4,
      "items": {"type": "object","required": ["headline","bullets"],"properties": {"headline": {"type": "string","minLength": 5},"context": {"type": "string"},"bullets": {"type": "array","minItems": 1,"maxItems": 3,"items": {"type": "string","minLength": 20}}},"additionalProperties": true}
    },
    "experience": {"type": "array","minItems": 1},
    "projects": {
      "type": "array","maxItems": 4,
      "items": {"type": "object","required": ["title","tools","link","bullets"],"properties": {"title": {"type": "string","minLength": 2},"tools": {"type": "string"},"dates": {"type": "string"},"link": {"type": "string","pattern": "^https?://(www\\.)?github\\.com/"},"link_label": {"type": "string"},"bullets": {"type": "array","minItems": 2,"maxItems": 3,"items": {"type": "string","minLength": 20}}},"additionalProperties": true}
    },
    "education": {"type": "array","minItems": 1},
    "section_order": {"type": "array","minItems": 4,"maxItems": 6,"uniqueItems": true,"items": {"enum": ["summary","impact","skills","experience","projects","education"]}},
    "section_labels": {"type": "object","required": ["summary","skills","experience","projects","education","impact"],"additionalProperties": {"type": "string","minLength": 2}},
    "layout_variant": {"enum": ["technical","strategy","commercial","football","product"]},
    "page_strategy": {
      "type": "object","required": ["recommended_page_length","maximum_pages","rationale","factors"],
      "properties": {"recommended_page_length": {"enum": [1,2]},"maximum_pages": {"enum": [1,2]},"rationale": {"type": "string","minLength": 20},"factors": {"type": "object"}},"additionalProperties": true
    },
    "bullet_strategy": {
      "type": "object","required": ["optimise_for","preferred_verbs","style"],
      "properties": {"optimise_for": {"type": "array","minItems": 2,"uniqueItems": true,"items": {"enum": ["technical_depth","commercial_influence","transformation","stakeholder_engagement","strategic_thinking","operational_optimisation","leadership"]}},"preferred_verbs": {"type": "array","minItems": 3,"items": {"type": "string"}},"style": {"type": "string","minLength": 20}},"additionalProperties": true
    },
    "classification_review": {"type": "string","minLength": 20},
    "layout_override_reason": {"type": "string","minLength": 20},
    "page_limit_exception": {"type": "boolean"}
  },
  "additionalProperties": true,
  "$defs": {
    "role_identity": {
      "type": "object",
      "required": ["archetype","confidence","secondary_archetypes","positioning_strategy","recommended_page_length"],
      "properties": {
        "archetype": {"enum": ["data_scientist","analytics_engineer","data_engineer","strategy_innovation_analyst","commercial_analyst","football_performance_analyst","football_strategy_analyst","business_intelligence_analyst","forecasting_pricing_analyst","product_analytics","marketing_analytics"]},
        "confidence": {"type": "number","minimum": 0,"maximum": 1},
        "secondary_archetypes": {"type": "array","maxItems": 3,"uniqueItems": true,"items": {"enum": ["data_scientist","analytics_engineer","data_engineer","strategy_innovation_analyst","commercial_analyst","football_performance_analyst","football_strategy_analyst","business_intelligence_analyst","forecasting_pricing_analyst","product_analytics","marketing_analytics"]}},
        "positioning_strategy": {"type": "string","minLength": 40},
        "recommended_page_length": {"enum": [1,2]},
        "page_length_rationale": {"type": "object"},
        "classification_scores": {"type": "object","additionalProperties": {"type": "number"}}
      },
      "additionalProperties": true
    }
  }
}
