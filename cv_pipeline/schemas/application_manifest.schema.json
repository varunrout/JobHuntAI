{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobhuntai.local/schemas/application_manifest.schema.json",
  "title": "JobHuntAI Application Quality Manifest",
  "type": "object",
  "required": ["contract", "decision", "artefacts", "checks", "tracker", "drive_save"],
  "properties": {
    "contract": {"const": "jobhuntai-application-quality-v1"},
    "decision": {"enum": ["apply", "apply_lightly", "park", "reject"]},
    "artefacts": {
      "type": "object",
      "required": [
        "job_description",
        "role_identity",
        "evidence_ranking",
        "cv",
        "cv_diagnostic",
        "cv_length_audit",
        "cv_pdf",
        "rendered_visual_review",
        "review_loop"
      ],
      "properties": {
        "job_description": {"type": "string", "minLength": 1},
        "role_identity": {"type": "string", "minLength": 1},
        "evidence_ranking": {"type": "string", "minLength": 1},
        "cv": {"type": "string", "minLength": 1},
        "cv_diagnostic": {"type": "string", "minLength": 1},
        "cv_length_audit": {"type": "string", "minLength": 1},
        "cv_pdf": {"type": "string", "minLength": 1},
        "rendered_visual_review": {"type": "string", "minLength": 1},
        "review_loop": {"type": "string", "minLength": 1},
        "cover_letter": {"type": "string", "minLength": 1},
        "cover_letter_pdf": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "object",
      "required": [
        "preflight",
        "duplicate",
        "visa",
        "role_identity",
        "evidence",
        "cv_length",
        "factual",
        "positioning",
        "visual",
        "render",
        "rendered_visual_review"
      ],
      "properties": {
        "preflight": {"$ref": "#/$defs/check"},
        "duplicate": {
          "allOf": [
            {"$ref": "#/$defs/check"},
            {
              "type": "object",
              "required": ["outcome"],
              "properties": {
                "outcome": {"enum": ["clear", "reapply_eligible", "existing_application", "unknown"]}
              }
            }
          ]
        },
        "visa": {
          "allOf": [
            {"$ref": "#/$defs/check"},
            {
              "type": "object",
              "required": ["outcome"],
              "properties": {
                "outcome": {"enum": ["viable", "uncertain_with_rationale", "unviable", "unknown"]},
                "rationale": {"type": "string"}
              }
            }
          ]
        },
        "role_identity": {"$ref": "#/$defs/check"},
        "evidence": {"$ref": "#/$defs/check"},
        "cv_length": {"$ref": "#/$defs/check"},
        "factual": {"$ref": "#/$defs/check"},
        "positioning": {"$ref": "#/$defs/check"},
        "visual": {"$ref": "#/$defs/check"},
        "render": {"$ref": "#/$defs/check"},
        "rendered_visual_review": {"$ref": "#/$defs/check"},
        "cover_letter": {"$ref": "#/$defs/check"}
      },
      "additionalProperties": true
    },
    "tracker": {
      "type": "object",
      "required": ["status", "mode"],
      "properties": {
        "status": {"enum": ["checked", "not_checked"]},
        "mode": {"enum": ["read_only", "editable"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "drive_save": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["verified", "unverified", "not_required"]},
        "files": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["passed", "failed", "blocked", "not_run"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
