{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobhuntai.local/schemas/evidence_candidate.schema.json",
  "title": "JobHuntAI evidence candidate",
  "type": "object",
  "required": ["id", "text", "source", "source_type", "claim_status", "dimensions"],
  "properties": {
    "id": {"type": "string", "minLength": 2},
    "text": {"type": "string", "minLength": 20},
    "source": {"type": "string", "minLength": 2},
    "source_type": {"enum": ["verified_employment", "verified_project", "portfolio", "inferred"]},
    "source_strength": {"type": "number", "minimum": 0, "maximum": 1},
    "claim_status": {"enum": ["measured", "verified", "association_only", "illustrative", "unsupported"]},
    "dimensions": {
      "type": "object",
      "properties": {
        "technical_depth": {"type": "number", "minimum": 0, "maximum": 5},
        "commercial_influence": {"type": "number", "minimum": 0, "maximum": 5},
        "transformation": {"type": "number", "minimum": 0, "maximum": 5},
        "stakeholder_engagement": {"type": "number", "minimum": 0, "maximum": 5},
        "strategic_thinking": {"type": "number", "minimum": 0, "maximum": 5},
        "operational_optimisation": {"type": "number", "minimum": 0, "maximum": 5},
        "leadership": {"type": "number", "minimum": 0, "maximum": 5},
        "domain_relevance": {"type": "number", "minimum": 0, "maximum": 5},
        "quantified_impact": {"type": "number", "minimum": 0, "maximum": 5},
        "evidence_strength": {"type": "number", "minimum": 0, "maximum": 5}
      },
      "additionalProperties": false
    },
    "keywords": {"type": "array", "items": {"type": "string"}},
    "locations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
